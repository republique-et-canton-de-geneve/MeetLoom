# Copy to .env. MeetLoom loads it automatically without overriding injected env.
# After npm run build: npm start
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Optional in development: the request/proxy host is used when unset.
# Required in production; set the exact browser origin, without a trailing slash.
# APP_ORIGIN=http://localhost:3000
# For a Vite development browser: APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
TRUST_PROXY=0
SQLITE_PATH=data/meetloom.sqlite
# DATABASE_URL=postgresql://meetloom:replace-me@localhost:5432/meetloom

# Required for first-account creation in production. Use a long random value.
# BOOTSTRAP_TOKEN=
# For Docker Compose only: choose a long random database password.
# POSTGRES_PASSWORD=

# Optional internal OpenAI-compatible API; leave absent to disable AI.
# LLM_BASE_URL=https://llm.internal.example.org/v1
# LLM_MODEL=your-internal-model-id
# LLM_VISION_MODEL=your-internal-vision-model-id
# LLM_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=100000
# NODE_EXTRA_CA_CERTS=/path/to/internal-ca.pem

# Optional organizational OpenID Connect (Authorization Code + PKCE).
# Requires APP_ORIGIN and an HTTPS issuer; no provider is contacted when absent.
# Callback registered with the provider: ${APP_ORIGIN}/api/auth/oidc/callback
# OIDC_ISSUER=https://identity.internal.example.org/realms/organisation
# OIDC_CLIENT_ID=meetloom
# OIDC_CLIENT_SECRET=
# existing: verified provider email must match a pre-existing local account.
# invited: also allows a verified email with an active administrator invitation.
# OIDC_ACCOUNT_POLICY=existing

# Optional SMTP. No email is sent unless SMTP_HOST and SMTP_FROM are configured.
# STARTTLS is mandatory when SMTP_SECURE=false; TLS certificates are verified.
# SMTP_HOST=smtp.internal.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=meetloom@example.org
# SMTP_SCHEDULED=true
# Digests/reminders also require each recipient's explicit profile preference.
